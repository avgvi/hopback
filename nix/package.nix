{
  lib,
  rustPlatform,
  installShellFiles,
  versionCheckHook,
}:
let
  manifest = builtins.fromTOML (builtins.readFile ../Cargo.toml);
in
rustPlatform.buildRustPackage {
  pname = manifest.package.name;
  inherit (manifest.package) version;

  src = lib.fileset.toSource {
    root = ../.;
    fileset = lib.fileset.unions [
      ../Cargo.toml
      ../Cargo.lock
      ../src
      ../tests
      ../skills
      ../man
    ];
  };
  cargoLock.lockFile = ../Cargo.lock;

  nativeBuildInputs = [ installShellFiles ];

  # The crate builds both commands, `hopback` and `hb`. Completions are
  # generated by the freshly built binary, one script per command name.
  postInstall = ''
    installManPage man/hopback.1
    for cmd in hopback hb; do
      installShellCompletion --cmd "$cmd" \
        --bash <("$out/bin/hopback" completions bash --command "$cmd") \
        --fish <("$out/bin/hopback" completions fish --command "$cmd") \
        --zsh <("$out/bin/hopback" completions zsh --command "$cmd")
    done
  '';

  doInstallCheck = true;
  nativeInstallCheckInputs = [ versionCheckHook ];
  versionCheckProgramArg = "--version";

  meta = {
    description = manifest.package.description;
    homepage = "https://github.com/avgvi/hopback";
    changelog = "https://github.com/avgvi/hopback/blob/v${manifest.package.version}/CHANGELOG.md";
    license = lib.licenses.mit;
    mainProgram = "hopback";
    platforms = [
      "aarch64-darwin"
      "x86_64-darwin"
      "aarch64-linux"
      "x86_64-linux"
    ];
  };
}
